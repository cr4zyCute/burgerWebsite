# ==========================================
# BURGER CRAFT ENVIRONMENT VARIABLES
# ==========================================

# 1. Turso Database (libSQL)
# Get these from your Turso dashboard: https://turso.tech
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# 2. Better Auth Configuration
# Generate a 32-character secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-char-random-secret-key-here
BETTER_AUTH_URL=http://localhost:5173

# 3. Object Storage for Media Library (Vercel Blob / S3)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here

# 4. App Port
PORT=5173
NODE_ENV=development
